% [split' N L H K] iff L=H++K and |K|=N
func split' int, list A -> list A, list A.
split' N L H K :- std.split-at N {std.rev L} K' H', std.rev H' H, std.rev K' K.

% [box N P P' R] when P' is P with strictly positive occurrences of R applied to N arguments boxed
% if N is unspecified, then the first encoutered application node should syntactically be a gfp
func box int, term -> term, term.
box N {{lp:P /\ lp:Q}} {{lp:P' /\ lp:Q'}} R :- !,
  box N P P' R, box N Q Q' R.
box N (prod V T P) (prod V T P') R :- !,
  pi x \ decl x V T ==> box N (P x) (P' x) R.
box N P P' R :- box.app N P P' R.

func same.gfp term, term -> .
same.gfp R S :- coq.unify-eq R S ok, !.
same.gfp R S :-
  coq.term->string R R',
  coq.term->string S S',
  coq.ltac.fail 0 "found two distinct gfps:\n" R' "\nand\n" S'.

func good.length list A, int -> .
good.length L N :- std.length L N, !.
good.length _ _ :- coq.ltac.fail 0 "invalid arity, please report".

func box.app int, term -> term, term.
box.app N (app [{{@gfp}},_,_,B|L]) (app ({{box_gfp lp:R}}::L)) R :- !,
  same.gfp R {{gfp lp:B}}, good.length L N.
box.app 0 R {{box_gfp lp:R'}} R' :- !,
  same.gfp R R'.
box.app N P P' R :-
  var N, !, declare_constraint (box.app N P P' R) [N].
box.app N (app (P::L)) (app ({{box_gfp lp:R}}::K)) R :- !,
  split' N L H K,
  same.gfp R (app (P::H)).
box.app _ P _ _ :-
  coq.term->string P P',
  coq.ltac.fail 0 "unrecognised subterm: " P'.


%% alternative and simpler version, when the same gfp occurs syntactically at all application nodes
%% (bound to magic arity 42 for now)
%
% box' P returns P where strictly positive occurrences of gfp are boxed
% second returned value is the common instance of [gfp ?b]
func box' term -> term,term.
box' {{lp:P /\ lp:Q}} {{lp:P' /\ lp:Q'}} GFP :- !,
  box' P P' GFP, box' Q Q' GFP.
box' (prod N T P) (prod N T P') GFP :- !,
  pi x \ decl x N T ==> box' (P x) (P' x) GFP.
box' (app ({{@gfp}}::_::_::B::L)) (app ({{box_gfp lp:GFP}}::L)) GFP :- !,
  same.gfp {{gfp lp:B}} GFP.
box' P _ _ :-
  coq.term->string P P',
  coq.ltac.fail 0 "unrecognised subterm: " P'.

% compute the type of term
func type.check term -> term.
type.check R T :- std.assert-ok! (coq.typecheck R T) "given constr does not typecheck".

% compute the arity of relation type
func arity term -> int.
arity (prod V S T) N' :- !,
  pi x \ decl x V S ==> arity (T x) N, N' is N + 1.
arity {{Prop}} 0 :- !.
arity T _ :-
  coq.term->string T T',
  coq.ltac.fail 0 "unrecognised arity: " T'.

% check that R is not a variable in the end
func not.var term -> .
not.var R :- not (var R), !.
not.var _ :- coq.ltac.fail 0 "could not recognise a gfp".

solve (goal _ _ P _ [trm R] as G) G' :-
  @ltacfail! 0 => std.do! [
	     type.check R TR,
  	     box {arity TR} P P' R,
	     refine {{(_: lp:P'): lp:P}} G G'
  ].

solve (goal _ _ P _ [int 42] as G) G' :-
  @ltacfail! 0 => std.do! [
   	     box' P P' R,
	     not.var R,
	     refine {{(_: lp:P'): lp:P}} G G'
  ].
  
solve (goal _ _ P _ [int N] as G) G' :-
  @ltacfail! 0 => std.do! [
  	     box N P P' R,
	     not.var R,
	     refine {{(_: lp:P'): lp:P}} G G'
  ].

solve (goal _ _ P _ [] as G) G' :-
  @ltacfail! 0 => std.do! [
  	     box _ P P' R,
	     not.var R,
	     refine {{(_: lp:P'): lp:P}} G G'
  ].


